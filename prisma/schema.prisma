generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  country       String
  paymentRegion String   @default("SEA") @map("payment_region")
  currency      String   @default("VND")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  venues        Venue[]

  @@map("organizations")
}

model Venue {
  id                    String                 @id @default(cuid())
  name                  String
  location              String?
  settings              Json                   @default("{}")
  active                Boolean                @default(true)
  expectedMaxPlayers    Int?                   @map("expected_max_players")
  playFrequency         String?                @map("play_frequency")
  playTypes             String[]               @default([]) @map("play_types")
  painPoints            String[]               @default([]) @map("pain_points")
  createdAt             DateTime               @default(now()) @map("created_at")
  logoUrl               String?                @map("logo_url")
  tvText                String?                @map("tv_text")
  bankAccount           String?                @map("bank_account")
  bankName              String?                @map("bank_name")
  bankOwnerName         String?                @map("bank_owner_name")
  billingStatus         String                 @default("active") @map("billing_status")
  ownerId               String?                @map("owner_id")
  slug                  String?                @unique
  portalEnabled         Boolean                @default(false) @map("portal_enabled")
  contactPhone          String?                @map("contact_phone")
  contactWhatsApp       String?                @map("contact_whatsapp")
  contactZalo           String?                @map("contact_zalo")
  contactLine           String?                @map("contact_line")
  timezone              String                 @default("Asia/Ho_Chi_Minh") @map("timezone")
  organizationId        String?                @map("organization_id")
  sportType             String                 @default("pickleball") @map("sport_type")
  auditLogs             AuditLog[]
  billingInvoices       BillingInvoice[]
  bookingGroups         BookingGroup[]
  bookings              Booking[]
  checkInPlayers        CheckInPlayer[]
  checkInRecords        CheckInRecord[]
  classInstances        ClassInstance[]
  programPasses         ProgramPass[]
  coachLessons          CoachLesson[]
  coachPackages         CoachPackage[]
  courtBlocks           CourtBlock[]
  courts                Court[]
  faceRecognitionLogs   FaceRecognitionLog[]
  manualBillingInvoices ManualBillingInvoice[]
  membershipTiers       MembershipTier[]
  memberships           Membership[]
  openPlayRegistrations OpenPlayRegistration[]
  pendingPayments       PendingPayment[]
  playerCoachCredits    PlayerCoachCredit[]
  playerNotes           PlayerNote[]
  registeredPlayers     Player[]               @relation("PlayerRegistrationVenue")
  programPassTypes      ProgramPassType[]
  sessions              Session[]
  signupDuplicateLogs   SignupDuplicateLog[]
  staffAssignments      StaffVenueAssignment[]
  subscriptionPackages  SubscriptionPackage[]
  billingRate           VenueBillingRate?
  organization          Organization?          @relation(fields: [organizationId], references: [id])
  owner                 StaffMember?           @relation("VenueOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@map("venues")
}

/// Unified identity record that can link a web-portal Player and/or a CourtPay CheckInPlayer to the same real person.
model PlayerIdentity {
  id             String          @id @default(cuid())
  name           String
  email          String?         @unique
  phone          String?
  skillLevel     String?         @map("skill_level")
  gender         String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  checkInPlayers CheckInPlayer[]
  players        Player[]

  @@map("player_identities")
}

model Player {
  id                    String                     @id @default(cuid())
  name                  String
  phone                 String                     @unique
  avatar                String                     @default("🏓")
  skillLevel            SkillLevel                 @default(beginner) @map("skill_level")
  gender                Gender
  gamePreference        GamePreference             @default(no_preference) @map("game_preference")
  notificationsEnabled  Boolean                    @default(false) @map("notifications_enabled")
  createdAt             DateTime                   @default(now()) @map("created_at")
  faceSubjectId         String?                    @map("face_subject_id")
  /// Public URL path served from /uploads (e.g. /uploads/players/{id}.jpg) — set on first face check-in enrollment
  facePhotoPath         String?                    @map("face_photo_path")
  rankingScore          Int                        @default(200) @map("ranking_score")
  rankingCount          Int                        @default(0) @map("ranking_count")
  lastRankedAt          DateTime?                  @map("last_ranked_at")
  /// Player-uploaded avatar photo, takes priority over facePhotoPath for display
  avatarPhotoPath       String?                    @map("avatar_photo_path")
  isWalkIn              Boolean                    @default(false) @map("is_walk_in")
  reclubUserId          Int?                       @map("reclub_user_id")
  registrationAt        DateTime?                  @map("registration_at")
  registrationVenueId   String?                    @map("registration_venue_id")
  coachStaffId          String?                    @map("coach_staff_id")
  email                 String?                    @unique @map("email")
  password_hash         String?
  playerIdentityId      String?                    @map("player_identity_id")
  /// Blurred + compressed copy of the first-registration check-in photo, generated async after registration for quality verification (served from /uploads/players/blurred/{id}.jpg)
  blurredFacePhotoPath  String?                    @map("blurred_face_photo_path")
  bookingGroups         BookingGroup[]
  bookings              Booking[]
  programPasses         ProgramPass[]
  coachLessons          CoachLesson[]
  faceAttempts          FaceAttempt[]
  faceRecognitionLogs   FaceRecognitionLog[]
  memberships           Membership[]
  openPlayRegistrations OpenPlayRegistration[]
  pendingPayments       PendingPayment[]
  accounts              PlayerAccount[]
  appAuthLogs           PlayerAppAuthLog[]
  coachCredits          PlayerCoachCredit[]
  customPrices          PlayerCustomPrice[]
  magicTokens           PlayerMagicToken[]
  playerNotes           PlayerNote[]
  passwordResetTokens   PlayerPasswordResetToken[]
  playerRankings        PlayerRanking[]
  stickerPacks          PlayerStickerPack[]
  stickerPhotos         PlayerStickerPhoto[]
  stickerResults        PlayerStickerResult[]
  coachStaff            StaffMember?               @relation("PlayerCoachLink", fields: [coachStaffId], references: [id], onUpdate: NoAction)
  playerIdentity        PlayerIdentity?            @relation(fields: [playerIdentityId], references: [id])
  registrationVenue     Venue?                     @relation("PlayerRegistrationVenue", fields: [registrationVenueId], references: [id])
  pushSubscriptions     PushSubscription[]
  queueEntries          QueueEntry[]
  signupDuplicateLogs   SignupDuplicateLog[]
  stickerJobs           StickerJobQueue[]
  stickerSessions       StickerSession[]

  @@index([registrationVenueId])
  @@index([playerIdentityId])
  @@index([coachStaffId])
  @@map("players")
}

model PlayerAppAuthLog {
  id        String              @id @default(cuid())
  playerId  String              @map("player_id")
  method    PlayerAppAuthMethod
  sessionId String?             @map("session_id")
  createdAt DateTime            @default(now()) @map("created_at")
  player    Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
  @@map("player_app_auth_logs")
}

model PushSubscription {
  id        String   @id @default(cuid())
  playerId  String   @map("player_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

/// Staff–venue membership with per-venue PWA app access (CourtFlow vs CourtPay).
model StaffVenueAssignment {
  id        String      @id @default(cuid())
  staffId   String      @map("staff_id")
  venueId   String      @map("venue_id")
  appAccess String[]    @default(["courtflow"]) @map("app_access")
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  venue     Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([staffId, venueId])
  @@index([staffId])
  @@index([venueId])
  @@map("staff_venue_assignments")
}

model StaffMember {
  id                        String                 @id @default(cuid())
  name                      String
  phone                     String                 @unique
  email                     String?                @unique
  role                      StaffRole              @default(staff)
  passwordHash              String                 @map("password_hash")
  onboardingCompleted       Boolean                @default(false) @map("onboarding_completed")
  createdAt                 DateTime               @default(now()) @map("created_at")
  coachBio                  String?                @map("coach_bio")
  coachPhoto                String?                @map("coach_photo")
  isCoach                   Boolean                @default(false) @map("is_coach")
  pushNotificationsEnabled  Boolean                @default(false) @map("push_notifications_enabled")
  /// Default Reclub club (group) for session roster — staff-level, not per-venue.
  reclubGroupId             Int?                   @map("reclub_group_id")
  coachDupr                 String?                @map("coach_dupr")
  coachGender               String?                @map("coach_gender")
  coachLanguages            String[]               @default([]) @map("coach_languages")
  coachSpecialties          String[]               @default([]) @map("coach_specialties")
  coachFocusLevels          String[]               @default([]) @map("coach_focus_levels")
  coachYearsExperience      String?                @map("coach_years_experience")
  coachGroupSizes           String[]               @default([]) @map("coach_group_sizes")
  googleRefreshToken        String?                @map("google_refresh_token")
  googleCalendarId          String?                @map("google_calendar_id")
  calendarSyncEnabled       Boolean                @default(false) @map("calendar_sync_enabled")
  creditPackageValidityDays Int                    @default(90) @map("credit_package_validity_days")
  auditLogs                 AuditLog[]
  classInstances            ClassInstance[]
  coachAvailabilities       CoachAvailability[]
  coachHolidays             CoachHoliday[]
  coachLessons              CoachLesson[]
  coachPackages             CoachPackage[]
  faceRecognitionLogs       FaceRecognitionLog[]
  coachCredits              PlayerCoachCredit[]
  customPrices              PlayerCustomPrice[]
  playerRankings            PlayerRanking[]
  linkedPlayers             Player[]               @relation("PlayerCoachLink")
  programPassTypeCoaches    ProgramPassTypeCoach[]
  programPassTypes          ProgramPassType[]
  sessions                  Session[]
  authLogs                  StaffAuthLog[]
  paidPayments              StaffPayment[]         @relation("PaidByStaff")
  payments                  StaffPayment[]         @relation("StaffPayments")
  pushTokens                StaffPushToken[]
  venueAssignments          StaffVenueAssignment[]
  ownedVenues               Venue[]                @relation("VenueOwner")

  @@map("staff_members")
}

model Court {
  id                         String            @id @default(cuid())
  venueId                    String            @map("venue_id")
  label                      String
  status                     CourtStatus       @default(idle)
  activeInSession            Boolean           @default(false) @map("active_in_session")
  isBookable                 Boolean           @default(false) @map("is_bookable")
  /// * After staff restores from maintenance/stand-by, assignments skip warmup until next maintenance.
  skipWarmupAfterMaintenance Boolean           @default(false) @map("skip_warmup_after_maintenance")
  bookings                   Booking[]
  classInstances             ClassInstance[]
  coachLessons               CoachLesson[]
  courtAssignments           CourtAssignment[]
  venue                      Venue             @relation(fields: [venueId], references: [id])
  playerRankings             PlayerRanking[]

  @@map("courts")
}

model Session {
  id                  String            @id @default(cuid())
  venueId             String            @map("venue_id")
  date                DateTime          @default(now())
  openedAt            DateTime          @default(now()) @map("opened_at")
  closedAt            DateTime?         @map("closed_at")
  status              SessionStatus     @default(open)
  gameTypeMix         Json?             @map("game_type_mix")
  maxPlayers          Int?              @map("max_players")
  staffId             String?           @map("staff_id")
  warmupMode          String            @default("manual") @map("warmup_mode")
  title               String?
  type                SessionType       @default(open_play)
  /// After the first real game starts, no new warm-up courts/assignments for this session.
  introWarmupComplete Boolean           @default(false) @map("intro_warmup_complete")
  sessionFee          Int               @default(0) @map("session_fee")
  reclubEventName     String?           @map("reclub_event_name")
  reclubReferenceCode String?           @map("reclub_reference_code")
  reclubRoster        Json?             @map("reclub_roster")
  reclubSnapshot      Json?             @map("reclub_snapshot")
  /// Device model/name of the staff phone that opened this session (e.g. "iPhone 15 Pro").
  openedOnDevice      String?           @map("opened_on_device")
  courtAssignments    CourtAssignment[]
  pendingPayments     PendingPayment[]
  playerGroups        PlayerGroup[]
  playerRankings      PlayerRanking[]
  queueEntries        QueueEntry[]
  staff               StaffMember?      @relation(fields: [staffId], references: [id])
  venue               Venue             @relation(fields: [venueId], references: [id])

  @@map("sessions")
}

model QueueEntry {
  id                    String         @id @default(cuid())
  sessionId             String         @map("session_id")
  playerId              String         @map("player_id")
  groupId               String?        @map("group_id")
  joinedAt              DateTime       @default(now()) @map("joined_at")
  status                QueueStatus    @default(waiting)
  breakUntil            DateTime?      @map("break_until")
  totalPlayMinutesToday Int            @default(0) @map("total_play_minutes_today")
  gamePreference        GamePreference @default(no_preference) @map("game_preference")
  queueNumber           Int?           @map("queue_number")
  group                 PlayerGroup?   @relation(fields: [groupId], references: [id])
  player                Player         @relation(fields: [playerId], references: [id])
  session               Session        @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, playerId])
  @@map("queue_entries")
}

model PlayerGroup {
  id           String       @id @default(cuid())
  sessionId    String       @map("session_id")
  code         String
  status       GroupStatus  @default(forming)
  createdAt    DateTime     @default(now()) @map("created_at")
  session      Session      @relation(fields: [sessionId], references: [id])
  queueEntries QueueEntry[]

  @@unique([sessionId, code])
  @@map("player_groups")
}

model CourtAssignment {
  id        String    @id @default(cuid())
  courtId   String    @map("court_id")
  sessionId String    @map("session_id")
  playerIds String[]  @map("player_ids")
  groupIds  String[]  @map("group_ids")
  gameType  GameType  @default(mixed) @map("game_type")
  isWarmup  Boolean   @default(false) @map("is_warmup")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  endedBy   String?   @map("ended_by")
  court     Court     @relation(fields: [courtId], references: [id])
  session   Session   @relation(fields: [sessionId], references: [id])

  @@map("court_assignments")
}

model PlayerRanking {
  id         String      @id @default(cuid())
  playerId   String      @map("player_id")
  courtId    String      @map("court_id")
  sessionId  String      @map("session_id")
  staffId    String      @map("staff_id")
  position   Int
  scoreDelta Int         @map("score_delta")
  createdAt  DateTime    @default(now()) @map("created_at")
  court      Court       @relation(fields: [courtId], references: [id], onDelete: Cascade)
  player     Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([sessionId, courtId])
  @@index([sessionId, courtId, createdAt])
  @@map("player_rankings")
}

model AuditLog {
  id        String       @id @default(cuid())
  venueId   String       @map("venue_id")
  staffId   String?      @map("staff_id")
  action    String
  targetId  String?      @map("target_id")
  reason    String?
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  staff     StaffMember? @relation(fields: [staffId], references: [id])
  venue     Venue        @relation(fields: [venueId], references: [id])

  @@map("audit_logs")
}

model StaffPayment {
  id            String        @id @default(cuid())
  staffId       String        @map("staff_id")
  weekStart     DateTime      @map("week_start")
  totalHours    Decimal       @map("total_hours") @db.Decimal(6, 1)
  amount        Decimal?      @db.Decimal(10, 0)
  paymentMethod String?       @map("payment_method")
  status        PaymentStatus @default(UNPAID)
  paidAt        DateTime?     @map("paid_at")
  paidDate      DateTime?     @map("paid_date")
  paidById      String?       @map("paid_by_id")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  paidBy        StaffMember?  @relation("PaidByStaff", fields: [paidById], references: [id])
  staff         StaffMember   @relation("StaffPayments", fields: [staffId], references: [id])

  @@unique([staffId, weekStart])
  @@index([weekStart])
  @@index([staffId])
  @@map("staff_payments")
}

model MembershipTier {
  id               String       @id @default(cuid())
  venueId          String       @map("venue_id")
  sortOrder        Int          @map("sort_order")
  name             String
  priceValue       Int          @map("price_value")
  sessionsIncluded Int?         @map("sessions_included")
  showBadge        Boolean      @default(false) @map("show_badge")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  perks            Json         @default("[]")
  venue            Venue        @relation(fields: [venueId], references: [id])
  memberships      Membership[]

  @@unique([venueId, sortOrder])
  @@map("membership_tiers")
}

model Membership {
  id           String              @id @default(cuid())
  playerId     String              @map("player_id")
  venueId      String              @map("venue_id")
  tierId       String              @map("tier_id")
  status       MembershipStatus    @default(active)
  activatedAt  DateTime            @default(now()) @map("activated_at")
  renewalDate  DateTime            @map("renewal_date")
  sessionsUsed Int                 @default(0) @map("sessions_used")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  payments     MembershipPayment[]
  player       Player              @relation(fields: [playerId], references: [id])
  tier         MembershipTier      @relation(fields: [tierId], references: [id])
  venue        Venue               @relation(fields: [venueId], references: [id])

  @@unique([playerId, venueId])
  @@index([venueId])
  @@index([tierId])
  @@map("memberships")
}

model MembershipPayment {
  id            String                  @id @default(cuid())
  membershipId  String                  @map("membership_id")
  periodStart   DateTime                @map("period_start")
  periodEnd     DateTime                @map("period_end")
  amountValue   Int                     @map("amount_value")
  status        MembershipPaymentStatus @default(UNPAID)
  paidAt        DateTime?               @map("paid_at")
  paymentMethod String?                 @map("payment_method")
  note          String?
  createdAt     DateTime                @default(now()) @map("created_at")
  proofUrl      String?                 @map("proof_url")
  membership    Membership              @relation(fields: [membershipId], references: [id])

  @@index([membershipId])
  @@index([status])
  @@map("membership_payments")
}

model CourtBlock {
  id        String         @id @default(cuid())
  venueId   String         @map("venue_id")
  type      CourtBlockType
  title     String?
  note      String?
  courtIds  String[]       @map("court_ids")
  date      DateTime       @db.Date
  startTime DateTime       @map("start_time")
  endTime   DateTime       @map("end_time")
  createdBy String?        @map("created_by")
  createdAt DateTime       @default(now()) @map("created_at")
  venue     Venue          @relation(fields: [venueId], references: [id])

  @@index([venueId, date])
  @@map("court_blocks")
}

model Booking {
  id              String        @id @default(cuid())
  courtId         String        @map("court_id")
  venueId         String        @map("venue_id")
  playerId        String        @map("player_id")
  date            DateTime      @db.Date
  startTime       DateTime      @map("start_time")
  endTime         DateTime      @map("end_time")
  status          BookingStatus @default(confirmed)
  priceValue      Int           @map("price_value")
  coPlayerIds     String[]      @map("co_player_ids")
  createdAt       DateTime      @default(now()) @map("created_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  paymentStatus   String?       @map("payment_status")
  paymentProofUrl String?       @map("payment_proof_url")
  holdExpiresAt   DateTime?     @map("hold_expires_at")
  paymentRef      String?       @unique @map("payment_ref")
  rejectedAt      DateTime?     @map("rejected_at")
  rejectedBy      String?       @map("rejected_by")
  rejectionReason String?       @map("rejection_reason")
  bookingGroupId  String?       @map("booking_group_id")
  paymentMethod   String?       @map("payment_method")
  bookingGroup    BookingGroup? @relation(fields: [bookingGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  court           Court         @relation(fields: [courtId], references: [id])
  player          Player        @relation(fields: [playerId], references: [id])
  venue           Venue         @relation(fields: [venueId], references: [id])

  @@index([venueId, date])
  @@index([playerId])
  @@map("bookings")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_codes")
}

model CoachPackage {
  id                       String              @id @default(cuid())
  coachId                  String              @map("coach_id")
  venueId                  String              @map("venue_id")
  name                     String
  description              String?
  lessonType               LessonType          @map("lesson_type")
  durationMin              Int                 @map("duration_min")
  priceValue               Int                 @map("price_value")
  sessionsIncluded         Int                 @default(1) @map("sessions_included")
  active                   Boolean             @default(true)
  sortOrder                Int                 @default(0) @map("sort_order")
  createdAt                DateTime            @default(now()) @map("created_at")
  minPlayers               Int?                @map("min_players")
  maxPlayers               Int?                @map("max_players")
  pricePerAdditionalPlayer Int?                @map("price_per_additional_player")
  lessons                  CoachLesson[]
  coach                    StaffMember         @relation(fields: [coachId], references: [id])
  venue                    Venue               @relation(fields: [venueId], references: [id])
  credits                  PlayerCoachCredit[]

  @@index([coachId])
  @@index([venueId])
  @@map("coach_packages")
}

model CoachLesson {
  id              String            @id @default(cuid())
  venueId         String            @map("venue_id")
  coachId         String            @map("coach_id")
  playerId        String            @map("player_id")
  courtId         String?           @map("court_id")
  packageId       String            @map("package_id")
  date            DateTime          @db.Date
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  status          CoachLessonStatus @default(confirmed)
  priceValue      Int               @map("price_value")
  note            String?
  createdAt       DateTime          @default(now()) @map("created_at")
  cancelledAt     DateTime?         @map("cancelled_at")
  paidAt          DateTime?         @map("paid_at")
  paymentMethod   String?           @map("payment_method")
  paymentNote     String?           @map("payment_note")
  proofUrl        String?           @map("proof_url")
  paymentStatus   String            @default("UNPAID") @map("payment_status")
  playerCount     Int?              @map("player_count")
  paymentRef      String?           @unique @map("payment_ref")
  rejectedAt      DateTime?         @map("rejected_at")
  rejectedBy      String?           @map("rejected_by")
  rejectionReason String?           @map("rejection_reason")
  googleEventId   String?           @map("google_event_id")
  coach           StaffMember       @relation(fields: [coachId], references: [id])
  court           Court?            @relation(fields: [courtId], references: [id])
  package         CoachPackage      @relation(fields: [packageId], references: [id])
  player          Player            @relation(fields: [playerId], references: [id])
  venue           Venue             @relation(fields: [venueId], references: [id])

  @@index([venueId, date])
  @@index([coachId, date])
  @@index([playerId])
  @@map("coach_lessons")
}

model CoachAvailability {
  id        String      @id @default(cuid())
  coachId   String      @map("coach_id")
  dayOfWeek Int         @map("day_of_week")
  startTime String      @map("start_time")
  endTime   String      @map("end_time")
  enabled   Boolean     @default(true)
  coach     StaffMember @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@map("coach_availabilities")
}

model CoachHoliday {
  id        String      @id @default(cuid())
  coachId   String      @map("coach_id")
  startDate DateTime    @map("start_date") @db.Date
