  subscriptionAddon  Int       @default(1000) @map("subscription_addon")
  sepayAddon         Int       @default(1000) @map("sepay_addon")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  /// Free flags per component — when true that component costs 0 on the weekly invoice
  isFreeBase         Boolean   @default(false) @map("is_free_base")
  isFreeSubAddon     Boolean   @default(false) @map("is_free_sub_addon")
  isFreeSepayAddon   Boolean   @default(false) @map("is_free_sepay_addon")
  /// "per_payment" (default) = weekly invoice per CourtPay payment; "monthly" = flat monthly rate
  billingModel       String    @default("per_payment") @map("billing_model")
  /// Flat monthly fee in VND — only used when billingModel = "monthly"
  monthlyRate        Int       @default(0) @map("monthly_rate")
  /// Date billing started under the monthly model — used to pro-rate the first invoice
  monthlyPeriodStart DateTime? @map("monthly_period_start")
  /// Optional end date for the monthly subscription — null means no expiry
  monthlyEndDate     DateTime? @map("monthly_end_date")
  /// "active" | "cancelled" | "inactive"
