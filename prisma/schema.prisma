  content   String
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id])

  @@unique([playerId, venueId])
  @@index([venueId])
  @@map("player_notes")
}

model EmailLog {
  id              String   @id @default(cuid())
  playerId        String   @map("player_id")
  bookingType     String   @map("booking_type")
  bookingId       String   @map("booking_id")
  emailType       String   @map("email_type")
  resendMessageId String?  @map("resend_message_id")
  sentAt          DateTime @default(now()) @map("sent_at")
  status          String   @default("sent")
  recipientRole   String   @default("student") @map("recipient_role")

  @@index([bookingId, emailType])
  @@map("email_logs")
}

model CreditTransaction {
  id        String            @id @default(cuid())
  creditId  String            @map("credit_id")
  lessonId  String?           @map("lesson_id")
  amount    Int
  reason    String
  createdAt DateTime          @default(now()) @map("created_at")
  credit    PlayerCoachCredit @relation(fields: [creditId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([creditId])
  @@map("credit_transactions")
}

/// One-time login tokens for players whose accounts were created by the
/// booking agent (no password known to the player). Each token may be
/// consumed exactly once; subsequent visits return a 410 Gone response.
model PlayerMagicToken {
  id        String    @id @default(cuid())
  playerId  String    @map("player_id")
  /// jti (JWT ID) stored so we can look up the token without embedding secrets
  jti       String    @unique @map("jti")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("player_magic_tokens")
}

/// Defines a recurring program-pass product sold at a venue (e.g. "Beginner Group 12-session pass").
/// cycleLengthDays is informational only — actual cycle boundaries are calendar-month-aligned in application code.
model ProgramPassType {
  id               String                 @id @default(cuid())
  venueId          String                 @map("venue_id")
  name             String
  price            Int
  sessionsIncluded Int                    @default(12) @map("sessions_included")
  /// Informational only. Cycle renewal logic is calendar-month-aligned in application code.
  cycleLengthDays  Int                    @default(30) @map("cycle_length_days")
  linkedCoachId    String?                @map("linked_coach_id")
  isActive         Boolean                @default(true) @map("is_active")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  classInstances   ClassInstance[]
  programPasses    ProgramPass[]
  coaches          ProgramPassTypeCoach[]
  linkedCoach      StaffMember?           @relation(fields: [linkedCoachId], references: [id], map: "class_pass_tiers_linked_coach_id_fkey")
  venue            Venue                  @relation(fields: [venueId], references: [id], map: "class_pass_tiers_venue_id_fkey")

  @@index([linkedCoachId], map: "class_pass_tiers_linked_coach_id_idx")
  @@index([venueId, isActive], map: "class_pass_tiers_venue_id_is_active_idx")
  @@map("program_pass_types")
}

/// A scheduled occurrence of a class that program-pass holders can check into.
model ClassInstance {
  id         String          @id @default(cuid())
  venueId    String          @map("venue_id")
  coachId    String          @map("coach_id")
  courtId    String?         @map("court_id")
  passTypeId String          @map("pass_type_id")
  startAt    DateTime        @map("start_at")
  endAt      DateTime        @map("end_at")
  maxPlayers Int             @map("max_players")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  checkIns   ClassCheckIn[]
  coach      StaffMember     @relation(fields: [coachId], references: [id])
  court      Court?          @relation(fields: [courtId], references: [id])
  passType   ProgramPassType @relation(fields: [passTypeId], references: [id], map: "class_instances_tier_id_fkey")
  venue      Venue           @relation(fields: [venueId], references: [id])

  @@index([venueId, startAt])
  @@index([coachId, startAt])
  @@index([passTypeId], map: "class_instances_tier_id_idx")
  @@map("class_instances")
}

/// Records a program-pass holder's attendance at a specific class instance.
/// Unique constraint on (programPassId, classInstanceId) prevents double check-in.
model ClassCheckIn {
  id              String        @id @default(cuid())
  programPassId   String        @map("class_pass_id")
  classInstanceId String        @map("class_instance_id")
  checkedInAt     DateTime      @default(now()) @map("checked_in_at")
  classInstance   ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  programPass     ProgramPass   @relation(fields: [programPassId], references: [id], onDelete: Cascade)

  @@unique([programPassId, classInstanceId])
  @@index([classInstanceId])
  @@map("class_check_ins")
}

/// Monthly/cycle payment record for a ProgramPass.
model ProgramPassPayment {
  id            String                 @id @default(cuid())
  programPassId String                 @map("class_pass_id")
  periodStart   DateTime               @map("period_start")
  periodEnd     DateTime               @map("period_end")
  amountValue   Int                    @map("amount_value")
  status        ClassPassPaymentStatus @default(UNPAID)
  paymentMethod String?                @map("payment_method")
  paidAt        DateTime?              @map("paid_at")
  proofUrl      String?                @map("proof_url")
  note          String?
  voidReason    String?                @map("void_reason")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  programPass   ProgramPass            @relation(fields: [programPassId], references: [id], onDelete: Cascade)

  @@index([programPassId])
  @@index([status])
  @@map("class_pass_payments")
}

/// A player's subscription to a ProgramPassType for a given cycle.
model ProgramPass {
  id                String               @id @default(cuid())
  playerId          String               @map("player_id")
  venueId           String               @map("venue_id")
  passTypeId        String               @map("pass_type_id")
  status            ClassPassStatus      @default(active)
  activatedAt       DateTime             @default(now()) @map("activated_at")
  deferredStartDate DateTime?            @map("deferred_start_date")
  cycleStart        DateTime             @map("cycle_start")
  cycleEnd          DateTime             @map("cycle_end")
  sessionsUsed      Int                  @default(0) @map("sessions_used")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  checkIns          ClassCheckIn[]
  payments          ProgramPassPayment[]
  player            Player               @relation(fields: [playerId], references: [id])
  passType          ProgramPassType      @relation(fields: [passTypeId], references: [id], map: "class_passes_tier_id_fkey")
  venue             Venue                @relation(fields: [venueId], references: [id])

  @@index([playerId, venueId])
  @@index([passTypeId], map: "class_passes_tier_id_idx")
  @@index([venueId, status])
  @@map("class_passes")
}

/// Join table linking a ProgramPassType to zero or more coaches.
model ProgramPassTypeCoach {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  passTypeId String          @map("pass_type_id")
  coachId    String          @map("coach_id")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  coach      StaffMember     @relation(fields: [coachId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  passType   ProgramPassType @relation(fields: [passTypeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([passTypeId, coachId])
  @@index([passTypeId])
  @@map("program_pass_type_coaches")
}

model schema_migrations {
  version String @id @db.VarChar
}

model BookingGroup {
  id              String    @id @default(cuid())
  venueId         String    @map("venue_id")
  playerId        String    @map("player_id")
  date            DateTime  @db.Date
  startTime       DateTime  @map("start_time") @db.Timestamp(6)
  endTime         DateTime  @map("end_time") @db.Timestamp(6)
  totalPriceValue Int       @default(0) @map("total_price_value")
  paymentRef      String?   @unique @map("payment_ref")
  paymentStatus   String?   @map("payment_status")
  holdExpiresAt   DateTime? @map("hold_expires_at") @db.Timestamp(6)
  status          String    @default("confirmed")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamp(6)
  player          Player    @relation(fields: [playerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  venue           Venue     @relation(fields: [venueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings        Booking[]

  @@index([playerId], map: "booking_groups_player")
  @@index([venueId, date], map: "booking_groups_venue_date")
  @@map("booking_groups")
}

model PlayerPasswordResetToken {
  id        String    @id @default(cuid())
  playerId  String    @map("player_id")
  jti       String    @unique @map("jti")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([playerId])
  @@map("player_password_reset_tokens")
}

